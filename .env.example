# No provider requests happen by default. Never add a real key to this file.
ENABLE_UNABATED=0
# Set only after confirming Free content-partner eligibility and traffic rules.
UNABATED_FREE_ELIGIBLE=0
UNABATED_API_KEY=
UNABATED_PARTNER_CODE=
# Local server binds to 127.0.0.1. Do not expose it publicly without authentication.
PORT=3000
